<script>
  (function () {
    // 兜底看门狗独立于插件初始化：3 秒内未完成 reveal 时强制显示 .slide-up 内容
    let fallbackApplied = false;
    const revealFallback = () => {
      if (fallbackApplied) return;
      fallbackApplied = true;
      document.documentElement.classList.add('sr-fallback');
    };
    const watchdog = setTimeout(() => revealFallback(), 3000);

    stellar.initPlugin(() => {
      const els = Array.prototype.slice.call(document.querySelectorAll('.slide-up'));
      if (els.length === 0) {
        clearTimeout(watchdog);
        return;
      }

    // 吸顶/固定定位容器内的元素始终在视口内（或由容器控制显隐），
    // 但 ScrollReveal 按文档坐标判断可见性，会误判这类元素为不可见，
    // 导致带锚点/恢复滚动位置打开页面时组件一直不显示。
    // 解决方式：以最近的吸顶/固定祖先作为该组元素的容器，
    // 使可见性判断恒成立，入场动画保留且不再依赖主文档滚动。
    const findPinnedContainer = (el) => {
      let node = el;
      while (node && node.nodeType === 1) {
        const pos = window.getComputedStyle(node).position;
        if (pos === 'sticky' || pos === 'fixed') return node;
        node = node.parentElement;
      }
      return null;
    };

    // 最近的滚动容器（overflow-y: auto/scroll）
    // 吸顶容器内可能存在内部滚动容器（如侧栏 .widgets），
    // 若直接用吸顶容器做 reveal 容器，折叠区下方的元素永远不会进入视口，导致一直不显示。
    const findScrollContainer = (el) => {
      let node = el.parentElement;
      while (node && node.nodeType === 1) {
        const oy = window.getComputedStyle(node).overflowY;
        if (oy === 'auto' || oy === 'scroll') return node;
        node = node.parentElement;
      }
      return null;
    };

    const pinnedGroups = new Map(); // 容器 -> 元素列表
    const targets = [];
    els.forEach((el) => {
      const pinned = findPinnedContainer(el);
      if (pinned) {
        // 优先使用最近的滚动容器，其次才用吸顶容器
        const container = findScrollContainer(el) || pinned;
        const group = pinnedGroups.get(container) || [];
        group.push(el);
        pinnedGroups.set(container, group);
      } else {
        targets.push(el);
      }
    });
    if (pinnedGroups.size === 0 && targets.length === 0) {
      clearTimeout(watchdog);
      return;
    }

    const slideUp = {
      distance: `<%- conf.distance %>`,
      duration: `<%- conf.duration %>`,
      interval: `<%- conf.interval %>`,
      scale: `<%- conf.scale %>`,
      opacity: 0,
      easing: "ease-out"
    };

    utils.js(`<%- conf.js %>`, { defer: true })
      .then(() => {
        if (fallbackApplied) return;
        if (typeof ScrollReveal !== 'function') {
          revealFallback();
          return;
        }
        try {
          const sr = ScrollReveal();
          if (targets.length > 0) {
            sr.reveal(targets, { ...slideUp });
          }
          pinnedGroups.forEach((group, container) => {
            sr.reveal(group, { ...slideUp, container: container });
          });

          // 页面高度变化后重新计算触发位置。
          // ScrollReveal 按初始化时的坐标判断可见性，页面高度变化（图片加载、
          // 折叠展开、tabs 切换、评论异步加载等）后坐标过期，导致下方未 reveal
          // 元素在错误位置触发或一直不显示（jlmakes/scrollreveal#569）。
          // 官方 sync() 有 bug，社区验证 delegate() 可用；防御性降级到 sync()。
          // delegate() 是文档未公开的函数。
          const resync = () => {
            try {
              if (typeof sr.delegate === 'function') {
                console.warn('[Plugin scrollreveal] 重算触发位置：使用 delegate()');
                sr.delegate();
              } else if (typeof sr.sync === 'function') {
                sr.sync();
              }
            } catch (err) {
              console.warn('[Plugin scrollreveal] 重算触发位置失败:', err);
            }
          };
          let resyncTimer = null;
          const scheduleResync = () => {
            if (resyncTimer) return;
            resyncTimer = setTimeout(() => {
              resyncTimer = null;
              resync();
            }, 300);
          };

          // 图片加载（load 不冒泡，需 capture 阶段监听）导致下方布局高度变化
          document.addEventListener('load', (e) => {
            if (e.target && e.target.nodeType === 1 && e.target.tagName === 'IMG') {
              scheduleResync();
            }
          }, true);

          // 页面全部资源（图片、字体等）加载完成后补一次重算
          window.addEventListener('load', scheduleResync);

          // DOM 结构变化：折叠面板、评论区、动态内容等。
          // 只观察子节点增删与 <details> 的 open 属性，不观察 style/class，
          // 避免被自身 reveal 写入的内联样式触发（防循环重算）。
          const mo = new MutationObserver((records) => {
            for (const r of records) {
              if (r.type === 'childList' && (r.addedNodes.length > 0 || r.removedNodes.length > 0)) {
                scheduleResync();
                return;
              }
              if (r.type === 'attributes' && r.attributeName === 'open') {
                scheduleResync();
                return;
              }
            }
          });
          mo.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['open']
          });

          // 主题 tabs 切换（仅切换 display/class，不产生 DOM 增删，需显式监听）
          document.addEventListener('tabs:click', scheduleResync);

          clearTimeout(watchdog);
        } catch (err) {
          console.error('[Plugin scrollreveal] 初始化失败:', err);
          revealFallback();
        }
      })
      .catch((err) => {
        console.error('[Plugin scrollreveal] 加载失败:', err);
        revealFallback();
      });
    }, 'scrollreveal');
  })();
</script>
