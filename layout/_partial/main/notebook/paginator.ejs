<% if ((page.total || 0) > 1) { %>
  <div class="paginator-wrap dis-select<%= scrollreveal(' ') %>" aria-label="笔记分页导航">
    <%- paginator({
      prev_text: icon('default:arrow-left'),
      next_text: icon('default:arrow-right'),
      force_prev_next: true,
      escape: false,
    }) %>
  </div>
<% } %>
