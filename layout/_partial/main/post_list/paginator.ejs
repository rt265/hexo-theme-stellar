<% if ((is_home() || is_category() || is_tag()) && page.total > 1) { %>
  <nav class='paginator-wrap dis-select<%- scrollreveal(' ') %>' aria-label='文章分页导航'>
    <%- paginator({
      prev_text: '上一页',
      next_text: '下一页',
      prev_class: 'extend prev',
      next_class: 'extend next',
      force_prev_next: true,
      escape: false
    }) %>
  </nav>
<% } %>
