  <nav class='paginator-wrap dis-select<%- scrollreveal(' ') %>' aria-label="文章分页导航">
  <%- paginator({
    prev_text: icon('solar:double-alt-arrow-left-bold-duotone'),
    next_text: icon('solar:double-alt-arrow-right-bold-duotone'),
    force_prev_next: true,
    escape: false
  }) %>
  </nav>
<% } %>
