<%
function layoutDiv() {
  var el = ''
  if (!is_post()) return el

  var sc = theme.symbols_count_time || {}
  var wpm = sc.wpm || 275

  el += '<div class="flex-row post-meta">'

  // 文章字数
  if (sc.symbols) {
    el += '<span class="text created">'
    el += __('meta.wordcount.prefix') + ' '
    el += symbolsCount(page)
    el += ' ' + __('meta.wordcount.suffix')
    el += '</span>'
  }

  // 阅读时长
  if (sc.time) {
    var hasWordCount = !!sc.symbols
    el += hasWordCount
      ? '<span class="sep updated"></span><span class="text updated">'
      : '<span class="text created">'
    el += __('meta.min2read.prefix') + __('symbol.colon')
    el += symbolsTime(page, undefined, wpm, __('meta.min2read.suffix'))
    el += '</span>'
  }

  el += '</div>'
  return el
}
%>
<%- layoutDiv() %>
