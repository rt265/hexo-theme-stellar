<%
var btns = [];
btns.push({
  key: 'followers',
  desc: 'followers',
  tab: 'followers'
});
btns.push({
  key: 'following',
  desc: 'following',
  tab: 'following'
});
btns.push({
  key: 'public_repos',
  desc: 'repos',
  tab: 'repositories'
});

function layoutDiv() {
  var el = '';
  if (item.username == undefined || item.username.length == 0) {
    return el;
  }
  if (item.follow == null) {
    item.follow = true;
  }

  el += `<widget class="widget-wrapper${scrollreveal(' ')} user-card ghuser">`
  // header
  if (item.header) {
    el += `<div class="widget-header">`
      el += `<a class="gh-url" href="https://github.com/${item.username}">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><!-- Icon from Huge Icons by Hugeicons - undefined --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.517 17.113c.395.578 1.592 1.81 3.225 2.12M9.864 22C8.836 21.83 2 19.606 2 12.093C2 5.063 8.002 2 12 2c4 0 10 3.063 10 10.093c0 7.513-6.836 9.738-7.864 9.907c0 0-.21-3.417-.087-4.003c.122-.586-.294-1.528-.294-1.528c.971-.364 2.45-.884 2.945-2.282c.385-1.084.627-2.658-.45-4.138c0 0 .282-2.39-.25-2.484c-.533-.092-2.1.947-2.1.947c-.457-.13-1.476-.377-1.898-.333c-.423-.044-1.445.203-1.902.333c0 0-1.568-1.04-2.1-.947s-.25 2.484-.25 2.484c-1.077 1.48-.835 3.054-.45 4.138c.496 1.398 1.974 1.918 2.945 2.282c0 0-.416.942-.294 1.528S9.864 22 9.864 22"/></svg>
        <span>github/${item.username}</span>
        </a>`
    el += `</div>`
  }
  // body
  el += '<div class="widget-body data-service ds-ghinfo" data-api="https://' + theme.api_host.ghapi + '/users/' + item.username + '">';
    if (item.avatar) {
      el += '<div class="avatar" ><img no-lazy type="img" id="avatar_url" src="' + config.avatar + '"></div>';
    }
    // username
    el += '<p class="username" type="text" id="name">&nbsp;</p>';
    el += '<p class="bio" type="text" id="bio">&nbsp;</p>';

    el += '<div class="buttons">';
      btns.forEach((btn, i) => {
        el += '<a class="btn" href="https://github.com/' + item.username + '?tab=' + btn.tab + '">';
        el += '<span class="title" type="text" id="' + btn.key + '">0</span>';
        el += '<span class="desc">' + btn.desc + '</span>';
        el += '</a>';
      });
    el += '</div>';
    // follow
    if (item.follow) {
      el += '<a class="follow" href="https://github.com/' + item.username + '">';
      el += icon('github:logo')
      el += 'Follow';
      el += '</a>';
    }
  el += '</div>';
  el += '</widget>';
  return el;
}
%>
<%- layoutDiv() %>
