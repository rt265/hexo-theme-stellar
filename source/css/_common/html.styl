*
  outline: none
  corner-shape: $corner-shape
html
  min-height: 100%
  width: 100%
  @supports not (-moz-appearance: none)
    scrollbar()
  overflow-y: auto
  background: var(--background)
  font-family: $ff-body
  font-size: var(--fs-root)
  scroll-padding-top: 0
body
  min-height: 100%
  background: var(--background)
  margin: 0
  text-rendering: auto
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0)
