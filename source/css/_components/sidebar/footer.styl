.l_left footer.footer
  margin: 0.5rem var(--gap-max) 1rem

.social-wrap
  display: grid
  gap: 0.25rem
  grid-template-columns: repeat(auto-fill, 44px)
  text-align: center
  .social
    width: 32px
    height: 32px
    display: inline-flex
    align-items: center
    justify-content: center
    padding: 6px
    border: none
    outline: none
    appearance: none
    font: inherit
    color: inherit
    cursor: pointer
    text-decoration: none
    border-radius: 50%
    overflow: hidden
    background: transparent
    filter: grayscale(100%)
    trans3: box-shadow background transform
    &:hover
      z-index: 1
      filter: none
      background: var(--bg-a100)
    &:focus-visible
      z-index: 2
      outline: 2px solid var(--primary-color)
      outline-offset: 2px
    &:active
      transform: scale(0.92)
    svg
      width: 32px
      height: 32px
      flex-shrink: 0
      vertical-align: middle
    img
      width: 32px
      height: 32px
      border-radius: 2px
